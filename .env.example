# Hoppr environment. Copy to `.env` and fill in once you create a Supabase
# project. Until these are set, the app runs on the local taste store + seed
# places (no backend required).
#
# EXPO_PUBLIC_ vars are inlined into the app bundle — only ever put the
# anon/public key here, never a service_role key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Places needs NO client-side key — the key lives server-side in the
# hoppr-places Edge Function. Configure it once with:
#   supabase secrets set GOOGLE_PLACES_API_KEY=...

# Place-card images (real venue photos + a static-map fallback). This one IS
# client-side (photo/static-map URLs must carry the key) — create a separate
# key, enable BOTH "Places API (New)" and "Maps Static API", and restrict it to
# your app/bundle id. Without it, cards show the striped placeholder.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Only needed locally to run `npm run eval:rerank` (eval/rerank/). Production
# reads this from the Supabase secret, never from the client bundle — do not
# prefix this one with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
