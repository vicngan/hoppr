{
  "expo": {
    "name": "Hoppr",
    "slug": "hoppr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/hoppr-mark.png",
    "scheme": "hoppr",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f2e8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.hoppr"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f2e8",
        "foregroundImage": "./assets/brand/hoppr-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/hoppr-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f2e8",
          "image": "./assets/brand/hoppr-mark.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hoppr uses your location to suggest places near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hoppr uses the camera so you can photograph a menu and it reads the dishes.",
          "photosPermission": "Hoppr accesses your photos so you can add a menu picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
